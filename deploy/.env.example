# Copyright (c) 2026 Federico Pereira <lord.basex@gmail.com>
#
# Local settings. `make up` copies this file to deploy/.env the first time,
# with a random TURN_SECRET (deploy/setup-env.sh); edit deploy/.env after.
# deploy/.env is ignored by git. Never commit real secrets.
# For a server, start from .env.production.example instead.

# Prefix of the containers and volumes.
COMPOSE_PROJECT=signalhub

# ---------------------------------------------------------------------------
# signalhub
# ---------------------------------------------------------------------------

# Host address where signalhub is published. Keep it on 127.0.0.1: in
# production Caddy is the only public entry point.
SIGNAL_BIND=127.0.0.1:8090

# Web origins allowed to open a WebSocket (comma separated). Native clients
# send no Origin and are always accepted. Locally: your dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App namespaces accepted (comma separated). Empty accepts any app.
ALLOWED_APPS=

# Lifetime of the 9-digit pairing code.
PAIRING_TTL=10m

# STUN server(s), comma separated, sent to every client in hello. The
# coturn below answers STUN too.
STUN_URLS=stun:127.0.0.1:3478

# TURN URLs handed to clients. They must point at the coturn below and be
# reachable from the browsers.
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp

# Shared secret between signalhub and coturn (TURN REST API), at least 32
# characters. deploy/setup-env.sh writes a random one (openssl rand -hex 32);
# this example value is too short on purpose: signalhub refuses it.
TURN_SECRET=change-me

# Lifetime of the TURN credentials sent in hello.
TURN_TTL=12h

# claim/reach/join attempts per minute per client IP.
RATE_LIMIT_PER_MIN=5

# Rooms a session may keep open at the same time.
MAX_ROOMS_PER_SESSION=1

# Header with the real client IP when a proxy sits in front of signalhub.
# Local (no proxy): empty. Production behind Caddy: X-Forwarded-For
CLIENT_IP_HEADER=

# debug, info, warn or error.
LOG_LEVEL=debug

# Abuse limits (these values are the defaults).
# register, room_open and invite_create per minute per IP.
OWNER_RATE_PER_MIN=30
# Connections open at once from one IP (IPv6: by /64) and in total.
MAX_CONNS_PER_IP=20
MAX_CONNS=5000
# Messages per second of one connection (bursts of twice that); above it
# the connection is closed.
MSG_RATE_PER_SEC=30

# ---------------------------------------------------------------------------
# coturn (STUN/TURN relay)
# ---------------------------------------------------------------------------

# Interface where the TURN ports are published. Local: 127.0.0.1.
TURN_BIND_IP=127.0.0.1

# Listening port (UDP and TCP). Change it if 3478 is taken on this computer
# (and in STUN_URLS/TURN_URLS above).
TURN_PORT=3478

# UDP port range used for relayed media.
TURN_MIN_PORT=49300
TURN_MAX_PORT=49320

# TURN realm, usually the TURN domain.
TURN_REALM=turn.localhost

# Address coturn announces to clients. Local: 127.0.0.1.
TURN_EXTERNAL_IP=127.0.0.1

# Quotas, so the relay cannot be used as free bandwidth (defaults): sessions
# per credential, sessions in total, and BYTES per second per session
# (500000 = 4 Mbps).
TURN_USER_QUOTA=8
TURN_TOTAL_QUOTA=300
TURN_MAX_BPS=500000

# ---------------------------------------------------------------------------
# Production only (Caddy)
# ---------------------------------------------------------------------------

# Public domain of signalhub: clients connect to wss://<SIGNAL_DOMAIN>/ws
SIGNAL_DOMAIN=signal.example.com

# Email for Let's Encrypt notices.
ACME_EMAIL=admin@example.com
