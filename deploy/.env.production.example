#
# Production settings for docker-compose.prod.yml. The first `make deploy`
# copies this file to deploy/.env on the server (mode 600) with a random
# TURN_SECRET; then set the domain, email, origins and addresses there.
# Never commit the real file.

# Prefix of the containers and volumes. Keep it once the server runs: the
# TLS certificates live in <project>_caddy_data.
COMPOSE_PROJECT=signalhub

# signalhub is only reached through Caddy (TLS) or an SSH tunnel.
SIGNAL_BIND=127.0.0.1:8090
# The websites that use this server.
ALLOWED_ORIGINS=https://app.example.com
# Empty accepts any app; list them to keep strangers out.
ALLOWED_APPS=
PAIRING_TTL=10m
# STUN and TURN are this server's coturn.
STUN_URLS=stun:signal.example.com:3478
TURN_URLS=turn:signal.example.com:3478?transport=udp,turn:signal.example.com:3478?transport=tcp
# Written by deploy/setup-env.sh (openssl rand -hex 32); this example value
# is too short on purpose: signalhub refuses it.
TURN_SECRET=change-me
TURN_TTL=12h
RATE_LIMIT_PER_MIN=5
MAX_ROOMS_PER_SESSION=1
# Caddy appends the client address here.
CLIENT_IP_HEADER=X-Forwarded-For
LOG_LEVEL=info

TURN_PORT=3478
TURN_MIN_PORT=49300
TURN_MAX_PORT=49400
TURN_REALM=example.com
# The server's public address, and after a slash its private one when the
# server sits behind NAT. Documentation addresses: use your own.
TURN_EXTERNAL_IP=203.0.113.10/10.0.0.10

SIGNAL_DOMAIN=signal.example.com
ACME_EMAIL=admin@example.com
